<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgDark"
    android:padding="20dp"
    tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cardDark"
            app:cardCornerRadius="16dp"
            app:contentPadding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Fuel Type"
                    android:textColor="@color/neonCyan"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:padding="4dp">
                    <Spinner
                        android:id="@+id/spinnerType"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/black"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFixedPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Market Price: RM 3.87 / Liter"
                    android:textColor="@color/neonGreen"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <Switch
                    android:id="@+id/switchBudi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Eligible for BUDI MADANI?"
                    android:textColor="@color/white"
                    android:layout_marginTop="8dp"
                    android:thumbTint="@color/neonCyan"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cardDark"
            app:cardCornerRadius="16dp"
            app:contentPadding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Pump Amount"
                    android:textColor="@color/neonCyan"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/radioGroupMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbLiters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="By Liters"
                        android:textColor="@color/white"
                        android:buttonTint="@color/neonCyan"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/rbPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="By Price (RM)"
                        android:textColor="@color/white"
                        android:buttonTint="@color/neonCyan"
                        android:layout_marginStart="16dp"/>
                </RadioGroup>

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Type Amount Here"
                    android:textColorHint="@color/textGray"
                    android:textColor="@color/white"
                    android:inputType="numberDecimal"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Or slide to adjust:"
                    android:textColor="@color/textGray"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="200.0"
                    app:thumbColor="@color/neonCyan"
                    app:trackColorActive="@color/neonCyan"
                    app:trackColorInactive="#333333"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cardDark"
            app:cardCornerRadius="16dp"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:id="@+id/tvLabelLiters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Liters @ RM3.87"
                        android:textColor="@color/textGray"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tvResultLiters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0.000 L"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Amount on pump"
                        android:textColor="@color/textGray"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tvResultPump"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="RM 0.00"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#333333"
                    android:layout_marginBottom="12dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Government Subsidy"
                        android:textColor="@color/textGray"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tvResultSubsidy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="RM 0.00"
                        android:textColor="@color/neonGreen"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </RelativeLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>